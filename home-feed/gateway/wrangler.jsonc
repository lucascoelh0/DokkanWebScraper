{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dokkanpanion-home-feed-r2-gateway",
  "account_id": "8445666d4a6685ae5701991745de0935",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "dokkanpanion-data"
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
