    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.0",
    "ts-node": "^10.9.1"
  },
  "devDependencies": {
    "@types/mocha": "^9.1.1",
    "@types/node": "16.x",
    "assert": "^2.0.0",
