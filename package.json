    "publish:r2": "npx ts-node publish-r2.ts",
    "run:fyi-contract-sample": "npx ts-node fyi-contract-sample.ts",
    "run:fyi-categories": "npx ts-node fyi-categories-run.ts",
    "run:fyi-experiment": "npx ts-node fyi-experiment.ts",
    "run:fyi-summons": "npx ts-node fyi-summons-run.ts",
    "run:fyi-stages": "npx ts-node fyi-stages-run.ts",
    "run:fyi-z-battles": "npx ts-node fyi-z-battles-run.ts",
    "run:fyi-wallpapers": "npx ts-node fyi-wallpapers-run.ts",
    "watch": "tsc -w",
    "prestart": "npm run build",
    "test": "npm run build && mocha --no-config \"lib/**/*.spec.js\"",
    "run": "npx ts-node index.ts"
